{
  "name": "codecrafters",
  "displayName": "Claude Code Clone",
  "description": "AI Coding assistant powered by LLMs",
  "version": "0.0.1",
  "publisher": "ParwathiJayaram",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-code-container",
          "title": "Claude Code",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "claude-code-container": [
        {
          "type": "webview",
          "id": "claudeCode.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeCode.ask",
        "title": "Ask Claude Code"
      }
    ],
    "configuration": {
      "title": "Claude Code",
      "properties": {
        "claudeCode.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Groq or OpenRouter",
          "order": 1
        },
        "claudeCode.provider": {
          "type": "string",
          "enum": ["groq", "openrouter", "openai"],
          "default": "groq",
          "description": "LLM provider to use",
          "order": 2
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.136.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "openai": "^7.10.0",
    "vscode-uri": "^3.2.0"
  }
}
